# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# =========================
# Virtual environment
# =========================
venv/
env/
ENV/
.env/
.venv/

# =========================
# FastAPI / Uvicorn / logs
# =========================
*.log
logs/
uvicorn.log

# =========================
# Environment variables
# IMPORTANT: never push DB credentials
# =========================
.env
.env.*
!.env.example

# =========================
# PostgreSQL local files (if any dumps/backups)
# =========================
*.sql
*.dump
*.backup
*.db

# =========================
# IDEs
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Testing / coverage
# =========================
.pytest_cache/
.coverage
htmlcov/

# =========================
# Migrations (OPTIONAL - depends on workflow)
# If using Alembic, keep this uncommented carefully
# =========================
# alembic/versions/*.pyc